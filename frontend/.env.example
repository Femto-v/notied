# Leave VITE_API_BASE unset to run the front-end in standalone DEMO MODE
# (in-memory mock backend — perfect for the 4 June progress evaluation).
#
# Once Reza's PHP Slim API is deployed, point this at it to use the real
# backend. In local dev you can instead rely on the Vite proxy in
# vite.config.js (which forwards /api -> http://localhost:8080).
#
# VITE_API_BASE=https://your-slim-api.example.com/api
